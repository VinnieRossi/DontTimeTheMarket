{
  "name": "@dttm/queries",
  "version": "0.0.0",
  "private": true,
  "description": "Typed calls against the API contract, and the cache keys that identify them",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
