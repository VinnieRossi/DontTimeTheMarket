    "@orpc/contract": "^1.15.4"
  },
  "devDependencies": {
    "@dttm/config": "workspace:*",
    "@vitest/coverage-v8": "^5.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
