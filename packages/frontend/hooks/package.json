{
  "name": "@dttm/hooks",
  "version": "0.0.0",
  "private": true,
  "description": "React integration over the query layer: nothing but binding",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dttm/queries": "workspace:*",
    "@dttm/types": "workspace:*",
    "@tanstack/react-query": "^5.104.0"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@dttm/config": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
