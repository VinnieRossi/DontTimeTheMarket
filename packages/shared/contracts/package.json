{
  "name": "@dttm/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "The API contract, the provider port interfaces, and the durable job contract",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
