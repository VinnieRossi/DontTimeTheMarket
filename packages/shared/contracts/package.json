    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dttm/config": "workspace:*",
    "@vitest/coverage-v8": "^5.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
