{
  "name": "@dttm/env",
  "version": "0.0.0",
  "private": true,
  "description": "The environment schema: one parse at boot, no process.env reads anywhere else",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dttm/types": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dttm/config": "workspace:*",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
