{
  "name": "@dttm/validation",
  "version": "0.0.0",
  "private": true,
  "description": "Input schemas: every number a player types is parsed by one of these",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
