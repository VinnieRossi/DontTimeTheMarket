{
  "name": "@dttm/services",
  "version": "0.0.0",
  "private": true,
  "description": "Business logic and the durable job pipeline",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dttm/auth": "workspace:*",
    "@dttm/contracts": "workspace:*",
    "@dttm/database": "workspace:*",
    "@dttm/logger": "workspace:*",
    "@dttm/types": "workspace:*",
    "@dttm/utils": "workspace:*",
    "@dttm/validation": "workspace:*",
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@dttm/config": "workspace:*",
    "@dttm/providers": "workspace:*",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
