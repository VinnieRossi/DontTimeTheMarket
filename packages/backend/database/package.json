{
  "name": "@dttm/database",
  "version": "0.0.0",
  "private": true,
  "description": "The schema source of truth, its migrations, and the clients that run them",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "default": "./src/runtime.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "^0.45.3",
    "drizzle-zod": "^0.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dttm/config": "workspace:*",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
