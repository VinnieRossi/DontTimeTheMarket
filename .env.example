# Copy to .env.local and fill in what your project actually needs.
# Every value below has a default that works, so a fresh clone runs with this file untouched.
# Never commit real secrets.

# --- App ---------------------------------------------------------
# development | test | production
NODE_ENV=development
APP_URL=http://localhost:3000
# debug | info | warn | error
LOG_LEVEL=info

# --- Providers ---------------------------------------------------
# mock runs every external capability as an in-process fake and needs no credentials.
# live requires a real adapter for every capability and refuses to boot while any of them is a
# fake or log-only one. The template ships no real mail adapter or session reader, so a project
# wires those before it can run live.
PROVIDER_MODE=mock

# Each provider can override the global default above, so an incremental build can run one
# capability live while another is still mocked, for example payments live with SMS still mocked.
# Unset, a provider inherits PROVIDER_MODE. In production, a provider may run mock only when its
# own override says so explicitly; inheriting a mocked global default in production fails boot,
# naming the provider. A new provider adds one line here, following the same <NAME>_PROVIDER_MODE
# shape.
# MAIL_PROVIDER_MODE=live

# --- Database ----------------------------------------------------
# Where the in-process Postgres keeps its files. A fresh clone needs nothing here.
# A project moving to a hosted Postgres replaces the one function that opens the connection.
DATABASE_DIR=.data/app-db

# --- Mail --------------------------------------------------------
# The address outbound mail is sent from, once a real mail adapter is wired.
MAIL_FROM=noreply@example.com

# --- Pipeline ----------------------------------------------------
# Shared secret the job-drain endpoint requires. Boot fails without it when NODE_ENV=production
# or PROVIDER_MODE=live.
PIPELINE_SECRET=
