{
  "name": "dont-time-the-market",
  "version": "0.0.0",
  "private": true,
  "description": "Trade a randomized slice of real market history and find out why timing it does not work",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "storybook": "pnpm --filter @dttm/ui storybook",
    "storybook:build": "turbo run storybook:build",
    "test:e2e": "pnpm --filter @dttm/e2e test:func",
    "test:visual": "pnpm --filter @dttm/e2e test:visual",
    "test:visual:update": "pnpm --filter @dttm/e2e test:visual:update",
    "e2e:install-browsers": "pnpm --filter @dttm/e2e install-browsers",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "bake-data": "tsx scripts/bake-data.ts",
    "verify": "tsx scripts/verify.ts",
    "verify:staged": "tsx scripts/verify.ts --staged",
    "validate": "tsx scripts/run-validators.ts",
    "validate:architecture": "tsx scripts/validate-architecture.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@dttm/config": "workspace:*",
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.3",
    "husky": "^9.1.7",
    "tsx": "^4.23.15",
    "turbo": "^2.11.4",
    "typescript": "^7.0.2"
  }
}
